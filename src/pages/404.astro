---
import Base from '../layouts/Base.astro';

/**
 * La página de "no existe".
 *
 * Cloudflare la sirve con un 404 de verdad (`not_found_handling = "404-page"`
 * en wrangler.toml). Importa para Google: si una dirección inventada devolviera
 * la portada con un 200, el buscador indexaría esa basura como si fueran
 * páginas de la tienda.
 */
---

<Base
  titulo="Página no encontrada"
  descripcion="Esta página no existe o ya no está disponible en AeroSocio."
>
  <section class="mx-auto max-w-xl px-4 py-24 text-center">
    <p class="text-6xl font-black text-ambar">404</p>
    <h1 class="mt-4 text-2xl font-black">No encontramos esta página</h1>
    <p class="mt-2 text-texto2">
      Puede que el producto ya no esté disponible o que la dirección esté mal escrita.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a
        href="/productos"
        class="rounded-full bg-ambar px-6 py-3 font-bold text-marino hover:bg-ambar-hondo"
      >
        Ver productos
      </a>
      <a href="/" class="rounded-full border border-borde px-6 py-3 font-bold hover:bg-tarjeta">
        Ir al inicio
      </a>
    </div>
  </section>
</Base>
