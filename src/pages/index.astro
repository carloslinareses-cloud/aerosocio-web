---
import Base from '../layouts/Base.astro';

/**
 * PORTADA PROVISIONAL.
 *
 * Existe solo para que el proyecto compile y se pueda validar la base. Se
 * reemplaza cuando llegue el estudio de mercado y se sepa qué se vende: una
 * portada genérica no posiciona en Google para nada concreto.
 *
 * Sin promesas tipo "el mejor precio": en España la publicidad engañosa a
 * consumidores está sancionada, y hasta tener el catálogo no hay con qué
 * sostener una afirmación así.
 */
---

<Base
  titulo="AeroSocio"
  descripcion="Productos en tendencia con envío a toda España. Compra fácil y pago seguro."
>
  <section class="mx-auto max-w-4xl px-4 py-24 text-center">
    <h1 class="text-4xl font-black leading-tight sm:text-6xl">
      Lo que España está buscando,
      <span class="block text-ambar">con envío a toda España</span>
    </h1>
    <p class="mx-auto mt-6 max-w-xl text-lg text-texto2">
      Estamos preparando el catálogo.
    </p>
  </section>
</Base>
